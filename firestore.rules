rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.role == 'owner'; }
    function ownTaId(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.taId; }
    function safeAccountSettings(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.schemaVersion == 12
        && request.resource.data.keys().hasOnly([
          'uid','schemaVersion','preferences','identityPublic','preferenceRevision',
          'v12Preferences','layoutState','drawings','workspaceRevision','live',
          'updatedByDevice','updatedAt'
        ])
        && (!('updatedByDevice' in request.resource.data) || request.resource.data.updatedByDevice is string)
        && (!('identityPublic' in request.resource.data)
          || !('taId' in request.resource.data.identityPublic)
          || request.resource.data.identityPublic.taId == ownTaId(uid)
          || request.resource.data.identityPublic.taId == ''
          || request.resource.data.identityPublic.taId == 'TA-PENDING');
    }

    // Public TA ID is profile metadata, never an authentication credential.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'free'
        && request.resource.data.plan == 'FREE'
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('taId' in request.resource.data) || request.resource.data.taId == null);
      allow update: if isOwner() || (signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']));
      allow delete: if isOwner();
    }

    // TA ID reservation map is backend/Owner-only. Ordinary clients read their TA ID from users/{uid}.
    match /taIds/{taId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /indicatorEntitlements/{entitlementId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
      allow write: if false;
    }

    match /indicatorProjects/{projectId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isOwner());
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.projectId == projectId;
      allow update: if isOwner() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','version','targetPlatform','description','parameters','visibility','sharedTaIds','updatedAt','licensingDefaults','draftMetadata'
        ]));
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isOwner());
    }

    match /indicatorVersions/{versionId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isOwner());
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.draft == true;
      allow update: if isOwner() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes','updatedAt']));
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isOwner());
    }

    match /accountSettings/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && safeAccountSettings(uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Proprietary TA Script and all broker/session secrets are Admin-SDK-only.
    match /indicatorPrograms/{indicatorId} { allow read, write: if false; }
    match /ctraderPrivateSessions/{docId} { allow read, write: if false; }
    match /ctraderSystemSessions/{docId} { allow read, write: if false; }
    match /ctraderOAuthStates/{docId} { allow read, write: if false; }

    // Default deny: new collections are private until explicitly reviewed.
    match /{document=**} { allow read, write: if false; }
  }
}
