# EXAMPLE NAMES ONLY — never commit real secret values.
NODE_ENV=production

# cTrader secrets stay in Secret Manager / server environment only.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://chart.tradeavata.com/ctrader-callback.html
CTRADER_PUBLIC_ACCESS_TOKEN=
CTRADER_PUBLIC_REFRESH_TOKEN=
CTRADER_PUBLIC_ACCOUNT_ID=
CTRADER_PUBLIC_ENV=demo
CTRADER_TOKEN_ENCRYPTION_KEY=

# Firebase Admin uses Application Default Credentials / workload identity.
FIREBASE_PROJECT_ID=trade-avata

# Exact browser origins only. After the custom domain is live, do NOT keep GitHub Pages here.
TRADE_AVATA_ORIGIN=https://chart.tradeavata.com
# Optional exact API/gateway hostnames, comma-separated (no scheme/port).
TRADE_AVATA_GATEWAY_HOSTS=api.tradeavata.com

# App Check is mandatory in production. This App ID is public identification, not a secret.
TRADE_AVATA_REQUIRE_APP_CHECK=true
TRADE_AVATA_APP_CHECK_APP_ID=1:912818772251:web:a66373dbf4f44f01299bbe

# Set true only behind a trusted reverse proxy such as Cloud Run / managed load balancer.
TRADE_AVATA_TRUST_PROXY=true

# Server-side Owner bootstrap. Never trust an email/role sent by the browser.
TRADE_AVATA_OWNER_UID=

# Safety limits (adjust only after load testing).
TRADE_AVATA_MAX_BODY_BYTES=1000000
TRADE_AVATA_MAX_WS_CLIENTS=5000
TRADE_AVATA_MAX_WS_PER_IP=20
TRADE_AVATA_MAX_SUBSCRIPTIONS=12
TRADE_AVATA_MAX_WS_MESSAGE_BYTES=32768
CTRADER_SYMBOL_ALIASES={}
